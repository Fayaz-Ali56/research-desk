# Optional. On first run the terminal asks for all of this and writes .env for you.
# Copy this file to .env only if you prefer to set things up by hand.

# Shown at the top of the app and used by the assistant to address you.
RESEARCHER_NAME=

# gemini | openrouter | anthropic | ollama | custom
PROVIDER=gemini

GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Pin a model per provider (use the exact name from the provider's model list)
# MODEL_GEMINI=gemini-2.0-flash
# MODEL_OPENROUTER=google/gemma-3-27b-it:free
# MODEL_ANTHROPIC=claude-sonnet-4-6

# Any OpenAI-compatible service
# CUSTOM_BASE_URL=https://example.com/v1
# CUSTOM_API_KEY=
# MODEL_CUSTOM=

# MAX_TOKENS=4096
# PORT=4173
